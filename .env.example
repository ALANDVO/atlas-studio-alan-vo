# Atlas Studio — example environment configuration.
# Copy to .env and fill in real values.  Never commit .env.

# Runtime environment (development | production)
ENVIRONMENT=development

# Database (SQLite by default; use postgresql+asyncpg:// in production)
DATABASE_URL=sqlite+aiosqlite:///./atlas_studio.db

# Demo auth — local only, refused in production.
AUTH_DEMO_MODE=true
AUTH_DEMO_ROLES=viewer,analyst,admin

# Secret key for session signing (min 8 chars; use a long random value)
SECRET_KEY=

# LLM provider (opt-in, never required for core scoring)
# Provider: openai-compatible | anthropic | gemini | ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
# Base URL for OpenAI-compatible / Ollama providers (optional)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10.0

# Server
HOST=127.0.0.1
PORT=8000

# Keycloak (planned OIDC provider)
KEYCLOAK_REALM=atlas-studio
KEYCLOAK_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=